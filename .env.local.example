# ==============================================================================
# Aura Luxe Home — Environment Configuration Template (.env.local.example)
# ==============================================================================
# Copy this file to .env.local:
#   cp .env.local.example .env.local
#
# IMPORTANT:
#   - Never commit .env.local or any real credentials to Git.
#   - Keep all production secrets secure in your environment configuration.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MongoDB Atlas Database Connection (Required)
# ------------------------------------------------------------------------------
# Format: mongodb+srv://<username>:<password>@<cluster-address>.mongodb.net/<dbname>?retryWrites=true&w=majority
# Notes:
#   - If your database password contains special characters (e.g. @, :, /), URL-encode them.
#   - Ensure your IP address (or 0.0.0.0/0 for cloud access) is whitelisted in MongoDB Atlas Network Access.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/auraluxe?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 2. Authentication & Session Security (Required)
# ------------------------------------------------------------------------------
# Secret key used to sign and verify stateless JWT session tokens (jose library).
# Generate a strong 64-character random key using: openssl rand -base64 48
JWT_SECRET=your_super_secure_jwt_secret_key_minimum_32_characters_here

# ------------------------------------------------------------------------------
# 3. Application Base URL (Required)
# ------------------------------------------------------------------------------
# Used for absolute URL generation, OAuth redirects, and asset resolution.
# Local development: http://localhost:3000
# Production: https://your-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 4. Cloudinary Persistent Media Storage (Required for Admin Image Uploads)
# ------------------------------------------------------------------------------
# Create a free account at https://cloudinary.com to get your dashboard credentials.
# Used for persistent cloud storage of product catalog images and bank slips.
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# 5. Initial Administrator Setup (Optional - for initial seeding only)
# ------------------------------------------------------------------------------
# If connecting an existing MongoDB database that already has an admin user,
# these variables are not required.
ADMIN_INITIAL_EMAIL=admin@auraluxe.lk
ADMIN_INITIAL_PASSWORD=your_initial_admin_password_here

# ------------------------------------------------------------------------------
# 6. OAuth 2.0 Social Sign-In (Optional)
# ------------------------------------------------------------------------------
# Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Authorized Redirect URI: <NEXT_PUBLIC_APP_URL>/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Meta for Developers: https://developers.facebook.com/apps
# Valid OAuth Redirect URI: <NEXT_PUBLIC_APP_URL>/api/auth/oauth/facebook/callback
FACEBOOK_CLIENT_ID=your_facebook_app_id
FACEBOOK_CLIENT_SECRET=your_facebook_app_secret

# ------------------------------------------------------------------------------
# 7. Customer Support WhatsApp Concierge (Optional)
# ------------------------------------------------------------------------------
# Verified business WhatsApp number in international format without +, spaces, or dashes.
# Example for Sri Lanka (+94 77 123 4567): 94771234567
NEXT_PUBLIC_WHATSAPP_NUMBER=94770000000

# ------------------------------------------------------------------------------
# 8. Official Social Media Channels (Optional - Footer Follow Us links)
# ------------------------------------------------------------------------------
# Provide full verified profile URLs.
# Leave blank to keep icons in a safe disabled state until verified accounts exist.
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_TIKTOK=

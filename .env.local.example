# MongoDB Atlas Database URI
# Replace with your MongoDB Atlas connection string:
# mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/auraluxe?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/auraluxe

# Authentication Secret (for JWT generation & verification)
JWT_SECRET=auraluxe_luxury_home_decor_secret_key_2026_super_secure

# Cloudinary Image Storage Credentials
# Create a free account at https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Store Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Default Initial Administrator Credentials (used in seed)
ADMIN_INITIAL_EMAIL=admin@auraluxe.lk
ADMIN_INITIAL_PASSWORD=AdminAuraLuxe2026!

# ==============================================================================
# OAuth 2.0 Social Authentication Credentials (Google & Facebook)
# ==============================================================================
# Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Authorized Redirect URI: http://localhost:3000/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_client_secret

# Meta for Developers: https://developers.facebook.com/apps
# Valid OAuth Redirect URI: http://localhost:3000/api/auth/oauth/facebook/callback
FACEBOOK_CLIENT_ID=your_facebook_app_id
FACEBOOK_CLIENT_SECRET=your_facebook_app_secret

# ==============================================================================
# Secure Payment Gateway Integration Credentials
# ==============================================================================
# PayHere (Sri Lanka's leading payment gateway for LKR, Visa, Mastercard & Genie)
# Dashboard: https://www.payhere.lk
PAYHERE_MERCHANT_ID=your_payhere_merchant_id
PAYHERE_SECRET=your_payhere_merchant_secret
PAYHERE_MODE=sandbox # 'sandbox' for test mode or 'live' for production

# Stripe (International & Local Card Processing with 3D Secure 2 / PCI-DSS Level 1)
# Dashboard: https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
